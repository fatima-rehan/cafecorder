# Copy to backend/.env and fill in. Never commit .env.
# Supabase dashboard > Connect > Session pooler. Keep the jdbc:postgresql:// prefix.
DB_URL=jdbc:postgresql://aws-0-ca-central-1.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-database-password

# Generate with: openssl rand -base64 48
JWT_SECRET=paste-a-long-random-value-here
CORS_ORIGINS=http://localhost:5173
